# ===========================================================================
# Example environment configuration.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored so your secrets never get committed. The application
# reads these via src/mlops/config.py (which uses python-dotenv).
# Every value here has a safe default in config.py, so the project runs
# end-to-end with NO .env file at all — you only need this to override things.
# ===========================================================================

# --- LLM diagnostic agent --------------------------------------------------
# Anthropic API key. If unset, the DiagnosticAgent transparently falls back
# to a deterministic rule-based diagnosis (so the demo works offline).
ANTHROPIC_API_KEY=

# Which Claude model the diagnostic agent should call.
MLOPS_LLM_MODEL=claude-sonnet-4-5

# --- MLflow ----------------------------------------------------------------
# Tracking store URI. Default is a local SQLite DB (./mlflow.db) which needs no
# running server AND supports the Model Registry (the plain file store does
# not). Point this at http://localhost:5000 to use a server/UI.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Where MLflow writes model/artifact files.
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# Name the model is registered under in the MLflow Model Registry.
MLOPS_MODEL_NAME=self_healing_classifier

# --- Serving ---------------------------------------------------------------
# Minimum accuracy the model must reach in evaluation to be promoted.
# The training pipeline's "quality gate" rejects models below this.
MLOPS_ACCURACY_GATE=0.80

# Host/port the FastAPI serving app binds to.
MLOPS_SERVE_HOST=0.0.0.0
MLOPS_SERVE_PORT=8000

# --- Drift detection thresholds --------------------------------------------
# PSI above this counts as drift (0.1 = minor, 0.2 = major shift).
MLOPS_PSI_THRESHOLD=0.2
# KS test p-value below this counts as drift (distributions differ).
MLOPS_KS_PVALUE_THRESHOLD=0.01

# --- Notifications (optional) ----------------------------------------------
# Incoming webhook for Slack/Discord alerts. If empty, alerts are logged only.
MLOPS_ALERT_WEBHOOK_URL=
